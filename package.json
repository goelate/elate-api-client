{
  "name": "@goelate/elate-api-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Elate API.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "sideEffects": false,
  "author": "Elate",
  "homepage": "https://goelate.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goelate/elate-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/goelate/elate-api-client/issues"
  },
  "keywords": [
    "elate",
    "api-client",
    "sdk",
    "typescript"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate": "openapi-typescript https://evoke.goelate.com/api/docs/openapi.yaml -o src/generated/schema.ts && prettier --write src/generated/schema.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "pack:check": "yarn pack --filename /tmp/elate-api-client.tgz && publint run /tmp/elate-api-client.tgz --pack false",
    "prepublishOnly": "yarn generate && git diff --exit-code -- src/generated/schema.ts",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.4",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
